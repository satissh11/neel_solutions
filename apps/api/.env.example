# API environment template
# Copy to .env and replace placeholders with deployment-specific values.

# MySQL connection (URL-encode special characters in the password)
DATABASE_URL="mysql://neel_app:YOUR_DB_PASSWORD@127.0.0.1:3306/neel_solutions"

# Use a long, random value (at least 32 characters) in production.
JWT_SECRET="CHANGE_ME_USE_A_LONG_RANDOM_SECRET"

PORT="5000"
WEB_ORIGIN="http://localhost:3000"

# Google Identity Services ID-token verification (same public client ID as the web app).
# No client secret is needed for this app's sign-in flow.
GOOGLE_CLIENT_ID=""

# Configure these only on the API host; never commit the values.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Official Meta WhatsApp Cloud API. Set an approved version and permanent system-user token.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION=""
WHATSAPP_TEMPLATE_DISPATCHED="order_dispatched"
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY="order_out_for_delivery"
WHATSAPP_TEMPLATE_DELIVERED="order_delivered"
WHATSAPP_TEMPLATE_LANGUAGE="en"
