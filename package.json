{
  "name": "neel-solutions",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npx prisma generate && npm run build --workspace=@neel-solutions/shared && npm run build --workspace=api && npm run build --workspace=web",
    "start": "node app.js",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "lint": "npm run lint --workspace apps/web"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2"
  }
}
