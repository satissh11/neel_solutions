# Copy to .env for local Prisma commands. Never commit the populated .env file.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/neel_solutions"

# Local development values only. Use unique secrets in deployment.
JWT_SECRET="CHANGE_ME_USE_A_LONG_RANDOM_SECRET"
PORT="3000"
API_PORT="5000"
WEB_ORIGIN="http://localhost:3000"

# Use the same Google Identity Services Web client ID in the web and API apps.
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Keep empty to use the same-origin API proxy.
NEXT_PUBLIC_API_URL=""
